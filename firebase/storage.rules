rules_version = '2';

// ASKTRO Storage rules — per-folder scoping. Reads are broad for public
// display assets (profiles, banners); writes are constrained to the owner
// and to sane content types / sizes. Sensitive verification docs are private.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'admin'; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isAudio() { return request.resource.contentType.matches('audio/.*'); }
    function underMB(n) { return request.resource.size < n * 1024 * 1024; }

    // True only if the caller is the customer or astrologer on this consultation.
    // Looks the session up in Firestore so chat media can't be read/written by a
    // stranger who merely knows (or guesses) the consultationId.
    function isParticipant(consultationId) {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/consultations/$(consultationId)).data.customerId == uid()
        || firestore.get(/databases/(default)/documents/consultations/$(consultationId)).data.astrologerId == uid()
      );
    }

    // Profile images: publicly readable, written by the owner only.
    match /profile_images/{userId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && uid() == userId && isImage() && underMB(5);
    }

    // Banners: public read, admin write.
    match /banner_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && underMB(8);
    }

    // Blog cover images: public read, admin write.
    match /blog_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && underMB(8);
    }

    // AstroMall product + category images — admin-authored in the portal.
    match /store_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && underMB(8);
    }

    // Admin-uploaded astrologer photos: public read, admin write.
    match /astrologer_photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && underMB(8);
    }

    // Push-notification / promo images: public read, admin write.
    match /notification_images/{fileName} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isImage() && underMB(8);
    }

    // Chat images: ONLY the two participants of the consultation (or an admin)
    // may read or write. Membership is verified against the Firestore session.
    match /chat_images/{consultationId}/{fileName} {
      allow read: if isAdmin() || isParticipant(consultationId);
      allow write: if isParticipant(consultationId) && isImage() && underMB(10);
    }

    // Voice notes: same participant-only access (feature not built yet, but the
    // slot is locked down so it can't be abused).
    match /voice_notes/{consultationId}/{fileName} {
      allow read: if isAdmin() || isParticipant(consultationId);
      allow write: if isParticipant(consultationId) && isAudio() && underMB(15);
    }

    // Astrologer documents / verification: private (owner + admin only).
    // Restrict content type to images/PDF so the bucket can't be used to host
    // arbitrary files (HTML/executables) under a user's own folder.
    match /documents/{userId}/{fileName} {
      allow read: if isSignedIn() && (uid() == userId || isAdmin());
      allow write: if isSignedIn() && uid() == userId && underMB(15)
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
    match /verification/{userId}/{fileName} {
      allow read: if isAdmin() || (isSignedIn() && uid() == userId);
      allow write: if isSignedIn() && uid() == userId && underMB(15)
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Scratch uploads, owner-scoped.
    match /temp_uploads/{userId}/{fileName} {
      allow read, write: if isSignedIn() && uid() == userId && underMB(20);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
