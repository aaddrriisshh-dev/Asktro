rules_version = '2';

// ASKTRO Firestore security rules — per-role, function-write-only money.
// Money/timer/billing fields are NEVER writable by clients. Cloud Functions
// use the Admin SDK which bypasses these rules, so all balance/session writes
// go through them. See docs/DATA_MODEL.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function claims() { return request.auth.token; }
    function isAdmin() { return isSignedIn() && claims().role == 'admin'; }
    function isSuperAdmin() { return isAdmin() && claims().adminRole == 'super'; }
    function isAstrologer() { return isSignedIn() && claims().role == 'astrologer'; }
    function isSelf(id) { return isSignedIn() && uid() == id; }

    // Only allow a client update if it does NOT touch protected fields.
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ================= users =================
    match /users/{userId} {
      // Only the user themselves and admins may read the real profile. Astrologers
      // must NOT — it holds phone/email/money. They read the SAFE mirror in
      // /customerProfiles instead (name + birth details, no PII), so a customer's
      // phone number can never reach an astrologer.
      allow read: if isSelf(userId) || isAdmin();
      allow create: if isSelf(userId)
        // a new profile must start with zeroed, function-owned money fields
        && request.resource.data.walletBalance == 0
        && request.resource.data.bonusBalance == 0
        && request.resource.data.lockedBalance == 0
        // chat-only welcome credit is function-granted at signup, never client-set
        && (!('chatBonusBalance' in request.resource.data)
            || request.resource.data.chatBonusBalance == 0);
      // clients may edit profile fields but never money/status/ledger fields.
      // NOTE: chatBonusBalance & chatGraceUsed are spendable/grace state owned by
      // the billing functions — a client must never write them.
      allow update: if isSelf(userId) && notChanging([
        'walletBalance','bonusBalance','chatBonusBalance','lockedBalance',
        'totalRecharge','totalSpent','pendingRefund','totalConsultations',
        'referralCode','referredBy','accountStatus','signupBonusGranted',
        'firstRechargeAt','chatGraceUsed'
      ]);
      allow delete: if false; // deletion only via Cloud Function
    }

    // ============ customerProfiles (safe mirror for astrologers) ============
    // A PII-free copy of the customer (name, photo, birth details) written by
    // Cloud Functions when a consultation starts. NO phone/email/money.
    // An astrologer may GET only a customer they have actually consulted (proven
    // by the astrologerCustomers membership marker) and may NEVER list the
    // collection — so no astrologer can enumerate/scrape the customer base.
    match /customerProfiles/{userId} {
      allow get: if isAdmin() || isSelf(userId)
        || (isAstrologer()
            && exists(/databases/$(database)/documents/astrologerCustomers/$(uid())/customers/$(userId)));
      allow list: if isAdmin();
      allow write: if false; // only Cloud Functions (Admin SDK) write this
    }

    // Membership markers: which customers an astrologer has consulted. Written by
    // Cloud Functions; backs the scoped customerProfiles read above.
    match /astrologerCustomers/{astrologerId}/customers/{customerId} {
      allow read: if isSelf(astrologerId) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ================= astrologers =================
    match /astrologers/{astrologerId} {
      // public directory is readable by any signed-in user
      allow read: if isSignedIn();
      allow create: if isAdmin();
      // astrologer may toggle their own presence/profile, never money/verify/
      // status/rate/commission/availability-lock (all function- or admin-owned).
      allow update: if isAdmin() || (isSelf(astrologerId) && notChanging([
        'rating','totalReviews','totalConsultations','followers','earnings',
        'pendingPayout','verified','featured','accountStatus',
        'commissionPercent','ratePerMinutePaise','available',
        // admin-owned flags: an astrologer must not self-promote or self-mark AI
        'isAI','risingStar'
      ]));
      allow delete: if isAdmin();

      // Private notes an astrologer keeps on a customer — only the owner. Rules
      // do not cascade into subcollections, so this needs its own match.
      match /notes/{noteId} {
        allow read, write: if isSelf(astrologerId);
      }

      // Contact PII (email/phone). Readable only by the astrologer themselves and
      // admins — never by customers. Written by Cloud Functions (admin actions).
      match /private/{doc} {
        allow read: if isSelf(astrologerId) || isAdmin();
        allow write: if false;
      }
    }

    // ================= remedies (astrologer -> customer suggestions) =================
    match /remedies/{remedyId} {
      // readable by the customer it's for, the astrologer who wrote it, or admin
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      // an astrologer creates a remedy addressed from themselves, and only for a
      // customer they have actually consulted (no pushing remedies to strangers)
      allow create: if isAstrologer()
        && isSelf(request.resource.data.astrologerId)
        && request.resource.data.customerId is string
        && exists(/databases/$(database)/documents/astrologerCustomers/$(uid())/customers/$(request.resource.data.customerId));
      // the customer may only flip the `done` flag — never rewrite the content
      allow update: if isSelf(resource.data.customerId) && notChanging([
        'customerId','astrologerId','astrologerName','astrologerPhoto',
        'consultationId','title','note','createdAt'
      ]);
      allow delete: if false;
    }

    // ================= consultations =================
    match /consultations/{consultationId} {
      // only the two participants (or admin) may read the session
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      // sessions are created & mutated ONLY by Cloud Functions
      allow create, update, delete: if false;

      // ---- messages subcollection ----
      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/consultations/$(consultationId)).data;
        }
        allow read: if isAdmin()
          || isSelf(parent().customerId)
          || isSelf(parent().astrologerId);
        // a participant may append their own messages; delivery/seen flags may
        // be flipped by the counterpart. No edits/deletes.
        allow create: if (isSelf(parent().customerId) || isSelf(parent().astrologerId))
          && request.resource.data.senderId == uid();
        allow update: if (isSelf(parent().customerId) || isSelf(parent().astrologerId))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['delivered','seen']);
        allow delete: if false;
      }

      // ---- typing presence (one doc per participant, id == uid) ----
      match /typing/{typerId} {
        function parent2() {
          return get(/databases/$(database)/documents/consultations/$(consultationId)).data;
        }
        allow read: if isSelf(parent2().customerId) || isSelf(parent2().astrologerId) || isAdmin();
        allow write: if isSelf(typerId)
          && (isSelf(parent2().customerId) || isSelf(parent2().astrologerId));
      }
    }

    // ================= walletTransactions (immutable ledger) =================
    match /walletTransactions/{txnId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false; // functions only
    }

    // ================= admin-managed catalogs (public read) =================
    match /rechargePlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /coupons/{couponId} {
      // Signed-in users may browse ACTIVE coupons (Offers screen + app-open
      // popup). Full validity/audience/usage is still enforced server-side at
      // redemption; inactive/unpublished codes stay hidden. Admins read all.
      allow read: if isAdmin() || (isSignedIn() && resource.data.active == true);
      allow write: if isAdmin();
    }
    match /couponRedemptions/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }

    // ================= broadcast history (admin-only summaries) =====
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false; // written by the sendBroadcast function only
    }

    // ================= notifications =================
    match /notifications/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      // user may only mark their own notification read
      allow update: if isSelf(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    // ================= referrals =================
    match /referrals/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.referrerId)
        || isSelf(resource.data.referredId);
      allow write: if false; // functions only
    }

    // ================= payouts =================
    match /payouts/{id} {
      allow read: if isAdmin() || isSelf(resource.data.astrologerId);
      // astrologer may request; approval/processing is function/admin only
      allow create: if isSelf(request.resource.data.astrologerId)
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // ================= support tickets =================
    match /supportTickets/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
      match /thread/{msgId} {
        allow read: if isAdmin() || isSelf(get(/databases/$(database)/documents/supportTickets/$(id)).data.customerId);
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // ================= global config =================
    match /config/{doc} {
      allow read: if isSignedIn();       // clients read price/warn-times
      allow write: if isSuperAdmin();    // only Super Admins change pricing/commission
    }

    // ================= CMS pages (privacy, terms, refund, about, faq) =======
    match /cms/{page} {
      allow read: if true;          // public legal/help content
      allow write: if isAdmin();
    }

    // ================= operational alerts & payment dead-letters (admin) =====
    // Written ONLY by Cloud Functions. Surfaces failed webhook credits and other
    // critical operational events to the admin portal; never client-writable.
    match /alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /failedWebhookCredits/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ================= admin-only areas =================
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false; // set via privileged function only
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // functions only, immutable
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
