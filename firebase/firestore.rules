rules_version = '2';

// ASKTRO Firestore security rules — per-role, function-write-only money.
// Money/timer/billing fields are NEVER writable by clients. Cloud Functions
// use the Admin SDK which bypasses these rules, so all balance/session writes
// go through them. See docs/DATA_MODEL.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function claims() { return request.auth.token; }
    function isAdmin() { return isSignedIn() && claims().role == 'admin'; }
    function isSuperAdmin() { return isAdmin() && claims().adminRole == 'super'; }
    // The customer money ledger is reconstructable revenue. Only the tiers whose
    // portal actually surfaces it (super = dashboard/reports, ops = reports +
    // user detail) may read it. The 'astrology' tier has no route that needs the
    // ledger, so it must not be able to read it straight from Firestore either.
    function canReadLedger() { return isAdmin() && (claims().adminRole == 'super' || claims().adminRole == 'ops'); }
    function isAstrologer() { return isSignedIn() && claims().role == 'astrologer'; }
    function isSelf(id) { return isSignedIn() && uid() == id; }

    // Only allow a client update if it does NOT touch protected fields.
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ================= users =================
    // A user's saved delivery addresses (store address book) — private to them.
    match /users/{userId}/shippingAddresses/{addrId} {
      allow read, write: if isSelf(userId);
    }

    match /users/{userId} {
      // Only the user themselves and money-trusted admins (super/ops) may read
      // the real profile — it holds phone/email AND live wallet/recharge/spend.
      // The 'astrology' tier is walled off (consistent with walletTransactions):
      // it has no route that needs customer PII or balances, so it must not read
      // them straight from Firestore. Astrologers (non-admin) read the SAFE
      // mirror in /customerProfiles (name + birth details, no PII) instead.
      allow read: if isSelf(userId) || canReadLedger();
      allow create: if isSelf(userId)
        // a new profile must start with zeroed, function-owned money fields
        && request.resource.data.walletBalance == 0
        && request.resource.data.bonusBalance == 0
        && request.resource.data.lockedBalance == 0
        // chat-only welcome credit is function-granted at signup, never client-set
        && (!('chatBonusBalance' in request.resource.data)
            || request.resource.data.chatBonusBalance == 0);
      // clients may edit profile fields but never money/status/ledger fields.
      // NOTE: chatBonusBalance & chatGraceUsed are spendable/grace state owned by
      // the billing functions — a client must never write them.
      allow update: if isSelf(userId) && notChanging([
        'walletBalance','bonusBalance','chatBonusBalance','lockedBalance',
        'totalRecharge','totalSpent','pendingRefund','totalConsultations',
        'referralCode','referredBy','accountStatus','signupBonusGranted',
        'firstRechargeAt','chatGraceUsed'
      ]);
      allow delete: if false; // deletion only via Cloud Function

      // Cached ProKerala readings (daily horoscope / kundli / panchang). These
      // are non-sensitive astrology results the app caches so it doesn't re-hit
      // the paid API. The user reads/writes only their own cache; the astrology
      // tier never reads it (a customer shares a kundli into chat explicitly).
      match /astro/{doc} {
        allow read, write: if isSelf(userId);
      }
    }

    // ============ customerProfiles (safe mirror for astrologers) ============
    // A PII-free copy of the customer (name, photo, birth details) written by
    // Cloud Functions when a consultation starts. NO phone/email/money.
    // An astrologer may GET only a customer they have actually consulted (proven
    // by the astrologerCustomers membership marker) and may NEVER list the
    // collection — so no astrologer can enumerate/scrape the customer base.
    match /customerProfiles/{userId} {
      allow get: if isAdmin() || isSelf(userId)
        || (isAstrologer()
            && exists(/databases/$(database)/documents/astrologerCustomers/$(uid())/customers/$(userId)));
      allow list: if isAdmin();
      allow write: if false; // only Cloud Functions (Admin SDK) write this
    }

    // Membership markers: which customers an astrologer has consulted. Written by
    // Cloud Functions; backs the scoped customerProfiles read above.
    match /astrologerCustomers/{astrologerId}/customers/{customerId} {
      allow read: if isSelf(astrologerId) || isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ================= astrologers =================
    match /astrologers/{astrologerId} {
      // public directory is readable by any signed-in user
      allow read: if isSignedIn();
      // Creating an astrologer sets verify/rate/AI flags — a privileged action,
      // super-admin only (the createAstrologer callable, admin-SDK, is the normal
      // path and bypasses rules; this only blocks direct lower-tier client writes).
      allow create: if isSuperAdmin();
      // Three tiers of write authority, least-privilege:
      //  - super-admin: may change anything (approval, rate, commission, money).
      //  - other admins (ops/astrology): may edit profile/marketing fields, but
      //    NEVER the money/approval/rate/verify fields — those mint value or
      //    approve earners and are reserved for super (mirrors the super-only
      //    setAstrologerStatus / adjustWallet gates at the function layer).
      //  - the astrologer themselves: only their own non-privileged fields.
      allow update: if isSuperAdmin()
        || (isAdmin() && notChanging([
            'verified','accountStatus','ratePerMinutePaise','commissionPercent',
            'earnings','pendingPayout','isAI'
          ]))
        || (isSelf(astrologerId) && notChanging([
        'rating','totalReviews','totalConsultations','followers','earnings',
        'pendingPayout','verified','featured','accountStatus',
        'commissionPercent','ratePerMinutePaise','available',
        // admin-owned flags: an astrologer must not self-promote or self-mark AI
        'isAI','risingStar'
      ]));
      allow delete: if isAdmin();

      // Private notes an astrologer keeps on a customer — only the owner. Rules
      // do not cascade into subcollections, so this needs its own match.
      match /notes/{noteId} {
        allow read, write: if isSelf(astrologerId);
      }

      // Private subdocs. The `financials` doc (earnings/pendingPayout/commission)
      // is money — restricted to the astrologer and money-trusted admins
      // (super/ops), NOT the astrology tier. Other private docs (contact PII)
      // stay readable by any admin for astrologer management. Function-written.
      match /private/{doc} {
        allow read: if isSelf(astrologerId)
          || (doc == 'financials' ? canReadLedger() : isAdmin());
        allow write: if false;
      }
    }

    // ================= remedies (astrologer -> customer suggestions) =================
    match /remedies/{remedyId} {
      // readable by the customer it's for, the astrologer who wrote it, or admin
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      // an astrologer creates a remedy addressed from themselves, and only for a
      // customer they have actually consulted (no pushing remedies to strangers)
      allow create: if isAstrologer()
        && isSelf(request.resource.data.astrologerId)
        && request.resource.data.customerId is string
        && exists(/databases/$(database)/documents/astrologerCustomers/$(uid())/customers/$(request.resource.data.customerId));
      // the customer may only flip the `done` flag — never rewrite the content
      allow update: if isSelf(resource.data.customerId) && notChanging([
        'customerId','astrologerId','astrologerName','astrologerPhoto',
        'consultationId','title','note','createdAt'
      ]);
      allow delete: if false;
    }

    // ================= consultations =================
    match /consultations/{consultationId} {
      // only the two participants (or admin) may read the session
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      // sessions are created & mutated ONLY by Cloud Functions
      allow create, update, delete: if false;

      // ---- messages subcollection ----
      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/consultations/$(consultationId)).data;
        }
        allow read: if isAdmin()
          || isSelf(parent().customerId)
          || isSelf(parent().astrologerId);
        // a participant may append their own messages; delivery/seen flags may
        // be flipped by the counterpart. No edits/deletes.
        allow create: if (isSelf(parent().customerId) || isSelf(parent().astrologerId))
          && request.resource.data.senderId == uid();
        allow update: if (isSelf(parent().customerId) || isSelf(parent().astrologerId))
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['delivered','seen']);
        allow delete: if false;
      }

      // ---- typing presence (one doc per participant, id == uid) ----
      match /typing/{typerId} {
        function parent2() {
          return get(/databases/$(database)/documents/consultations/$(consultationId)).data;
        }
        allow read: if isSelf(parent2().customerId) || isSelf(parent2().astrologerId) || isAdmin();
        allow write: if isSelf(typerId)
          && (isSelf(parent2().customerId) || isSelf(parent2().astrologerId));
      }
    }

    // ================= presence (astrologer online heartbeat) ==============
    // The astrologer writes ONLY a heartbeat timestamp here while online; a sweep
    // reads it to force a crashed/dropped app offline. Kept off the public doc so
    // the frequent write never churns the directory. Client may only write
    // lastSeen (never flip anyone else's presence).
    match /presence/{astrologerId} {
      allow read: if isSelf(astrologerId) || isAdmin();
      // The doc only ever holds a lastSeen timestamp; the owner writes their own.
      allow write: if isSelf(astrologerId)
        && request.resource.data.keys().hasOnly(['lastSeen']);
    }

    // ============ astrologerLedger (immutable astrologer earnings trail) ======
    // Append-only double-entry trail for astrologer earnings/payouts/refund
    // reversals. The astrologer reads their own; admins read all. Function-write.
    match /astrologerLedger/{txnId} {
      allow read: if isAdmin() || isSelf(resource.data.astrologerId);
      allow write: if false;
    }

    // ================= walletTransactions (immutable ledger) =================
    match /walletTransactions/{txnId} {
      // The owner always reads their own rows; among admins only super+ops (the
      // tiers whose UI surfaces the ledger) — never the astrology tier.
      allow read: if canReadLedger() || isSelf(resource.data.userId);
      allow write: if false; // functions only
    }

    // ================= admin-managed catalogs (public read) =================
    match /rechargePlans/{planId} {
      allow read: if isSignedIn();
      // A recharge plan defines how much wallet value a payment yields — writing
      // one is a money action, so super-admin only (mirrors adjustWallet).
      allow write: if isSuperAdmin();
    }
    match /banners/{bannerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /blogs/{blogId} {
      // Signed-in users read PUBLISHED blogs; admins also read drafts. Authored
      // in the admin portal. Content only — nothing sensitive here.
      allow read: if isSignedIn() && (resource.data.published == true || isAdmin());
      allow write: if isAdmin();
    }
    match /coupons/{couponId} {
      // Signed-in users may browse ACTIVE coupons (Offers screen + app-open
      // popup). Full validity/audience/usage is still enforced server-side at
      // redemption; inactive/unpublished codes stay hidden. Admins read all.
      allow read: if isAdmin() || (isSignedIn() && resource.data.active == true);
      // A coupon grants free wallet/bonus credit — authoring one mints money, so
      // super-admin only. Closes the lower-tier-admin self-coupon mint path.
      allow write: if isSuperAdmin();
    }
    match /couponRedemptions/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }

    // ================= AstroMall store =============================
    // Catalog (categories + products) is a public read for signed-in users;
    // only admins author it. Pricing/stock live here but nothing sensitive.
    match /storeCategories/{catId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /storeProducts/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Product reviews — read for signed-in users; authored/moderated by admins
      // for now (customer submission with moderation comes later).
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
    // Storefront content blocks (testimonials, videos, FAQs) — same contract as
    // the catalog: signed-in read, admin-only authoring.
    match /storeTestimonials/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /storeVideos/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /storeFaqs/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /storeBanners/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Discount codes — signed-in read (to preview a code at checkout); only
    // admins author them, and usedCount is bumped server-side on paid orders.
    match /storeCoupons/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // Orders: a customer reads only their own; admins read all. Orders are
    // created + mutated ONLY by the store callables/webhook (server computes the
    // price, decrements stock, advances status) — never by the client.
    match /storeOrders/{orderId} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      // Customers never write. The order is created + paid + stock-decremented
      // ONLY by the store callables/webhook (admin SDK, bypasses rules). Admins
      // may advance fulfilment (status, courier, tracking, notes) but can NEVER
      // alter money / ownership / items — those are server-set at checkout.
      allow create: if false;
      allow update: if isAdmin() && notChanging([
        'userId', 'items', 'itemCount', 'subtotalPaise', 'shippingPaise',
        'totalPaise', 'razorpayOrderId', 'paymentId', 'createdAt', 'orderNo',
      ]);
      allow delete: if false;
    }
    match /storeOrderBindings/{orderId} {
      allow read, write: if false; // server-only (webhook resolution)
    }

    // ================= broadcast history (admin-only summaries) =====
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false; // written by the sendBroadcast function only
    }

    // ================= notifications =================
    match /notifications/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      // user may only mark their own notification read
      allow update: if isSelf(resource.data.userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    // ================= referrals =================
    match /referrals/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.referrerId)
        || isSelf(resource.data.referredId);
      allow write: if false; // functions only
    }

    // ================= payouts =================
    match /payouts/{id} {
      allow read: if isAdmin() || isSelf(resource.data.astrologerId);
      // astrologer may request; approval/processing is function/admin only
      allow create: if isSelf(request.resource.data.astrologerId)
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    // ============ kundliMatches (admin sales log for paid ₹49 reports) ========
    // Denormalized, PII-light record written by purchaseKundliMatch (admin SDK).
    // Only admins read it; clients never touch it (they have their own private
    // copy under users/{uid}/astro).
    match /kundliMatches/{id} {
      allow read: if isAdmin();
      allow write: if false; // functions only (admin SDK bypasses rules)
    }

    // ================= support tickets =================
    match /supportTickets/{id} {
      allow read: if isAdmin()
        || isSelf(resource.data.customerId)
        || isSelf(resource.data.astrologerId);
      // A ticket may only be opened by its OWN owner — the customerId (or
      // astrologerId) stamped on the new doc must be the caller. Prevents opening
      // a ticket under another user's identity.
      allow create: if isSignedIn()
        && (isSelf(request.resource.data.customerId) || isSelf(request.resource.data.astrologerId));
      allow update: if isAdmin();
      allow delete: if false;
      match /thread/{msgId} {
        function ticket() { return get(/databases/$(database)/documents/supportTickets/$(id)).data; }
        // Read AND append only by an admin or a participant of the PARENT ticket
        // (checks both customerId and astrologerId — fixes the earlier bug where
        // an astrologer could never read their own thread, and closes the IDOR
        // where any signed-in user could post into anyone's thread).
        allow read: if isAdmin() || isSelf(ticket().customerId) || isSelf(ticket().astrologerId);
        allow create: if isAdmin() || isSelf(ticket().customerId) || isSelf(ticket().astrologerId);
        allow update, delete: if false;
      }
    }

    // ================= global config =================
    match /config/{doc} {
      allow read: if isSignedIn();       // clients read price/warn-times
      allow write: if isSuperAdmin();    // only Super Admins change pricing/commission
    }

    // ================= CMS pages (privacy, terms, refund, about, faq) =======
    match /cms/{page} {
      allow read: if true;          // public legal/help content
      allow write: if isAdmin();
    }

    // ================= home sections (portal-managed home content) =========
    // Typed, ordered home blocks (e.g. the "trust" assurance band). Content
    // is curated in the portal and rendered live in the app.
    match /homeSections/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ================= moderation: reports / blocks / image review =========
    // A signed-in user may FILE a report (naming themselves as reporter) and
    // read their own; admins read/triage all. Reports are never editable by
    // clients (status changes go through admin functions/console).
    match /reports/{id} {
      allow read: if isAdmin() || isSelf(resource.data.reporterId);
      allow create: if isSignedIn() && request.resource.data.reporterId == uid();
      allow update, delete: if false;
    }
    // A user's block list. Only the owner reads it; writes go through the
    // blockUser/unblockUser functions (Admin SDK) so the shape stays trusted.
    match /userBlocks/{ownerId} {
      allow read: if isSelf(ownerId) || isAdmin();
      allow write: if false;
    }
    // Image-moderation queue — admins only; written by the Storage trigger.
    match /imageModeration/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ================= consent records (immutable audit trail) =============
    // Written ONLY by Cloud Functions. The user may read their own consent
    // history; admins read all. Never client-writable.
    match /consentRecords/{id} {
      allow read: if isAdmin() || isSelf(resource.data.userId);
      allow write: if false;
    }

    // ================= operational alerts & payment dead-letters (admin) =====
    // Written ONLY by Cloud Functions. Surfaces failed webhook credits and other
    // critical operational events to the admin portal; never client-writable.
    match /alerts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /failedWebhookCredits/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ================= admin-only areas =================
    match /adminUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false; // set via privileged function only
    }
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false; // functions only, immutable
    }
    // Per-day analytics rollup for the dashboard (aggregate counters only, no
    // per-user detail). Any admin tier may read; the rollup triggers write it.
    match /dailyStats/{day} {
      allow read: if isAdmin();
      allow write: if false; // functions only
    }

    // default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
