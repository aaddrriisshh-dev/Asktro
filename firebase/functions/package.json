{
  "name": "asktro-functions",
  "version": "1.0.0",
  "description": "ASKTRO Cloud Functions — server-authoritative billing, wallet, consultations",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "lint": "eslint --ext .ts src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "cd .. && firebase emulators:exec --only firestore --project demo-asktro \"cd functions && npx jest -c jest.integration.config.js --ci\"",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.7",
    "agora-token": "^2.0.4",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.1",
    "razorpay": "^2.9.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "firebase-tools": "^13.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  },
  "private": true
}
