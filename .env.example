# ============================================================================
# ASKTRO — Example environment / config values (PLACEHOLDERS ONLY)
# ----------------------------------------------------------------------------
# NEVER commit real secrets. See docs/SETUP_CHECKLIST.md for where each value
# comes from and which phase it unblocks. Secrets marked (FUNCTIONS ONLY) must
# live in Cloud Functions config, never in any client app.
# ============================================================================

# ---- App identifiers (decide once — SETUP_CHECKLIST §0) --------------------
CUSTOMER_ANDROID_APP_ID=com.asktro.customer
CUSTOMER_IOS_BUNDLE_ID=com.asktro.customer
ASTROLOGER_ANDROID_APP_ID=com.asktro.astrologer
ASTROLOGER_IOS_BUNDLE_ID=com.asktro.astrologer

# ---- Firebase (web config — used by Admin portal & Flutter web) ------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Native app config files (NOT env vars — placed in the app folders):
#   apps/customer/android/app/google-services.json
#   apps/customer/ios/Runner/GoogleService-Info.plist
#   apps/astrologer/android/app/google-services.json
#   apps/astrologer/ios/Runner/GoogleService-Info.plist

# ---- Razorpay (payments) ---------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret          # (FUNCTIONS ONLY)
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret  # (FUNCTIONS ONLY)

# ---- Agora (voice & video) -------------------------------------------------
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate      # (FUNCTIONS ONLY)

# ---- Admin portal (apps/admin/.env.local uses NEXT_PUBLIC_* mirror) --------
# NEXT_PUBLIC_FIREBASE_API_KEY, NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN, etc.
# (same Firebase web config values above, prefixed with NEXT_PUBLIC_)

# ---- Functions runtime config (set via `firebase functions:config:set` or
#      secrets manager; mirrored here for reference) -------------------------
# razorpay.key_id, razorpay.key_secret, razorpay.webhook_secret,
# agora.app_id, agora.app_certificate
