<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 13+ requires this for FCM push notifications to be delivered;
         without it the runtime prompt never shows and notifications are dropped. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Voice/video calls (Agora RTC). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- The Agora RTC library declares FOREGROUND_SERVICE_MEDIA_PROJECTION for its
         optional screen-sharing feature, which this app does NOT use. Strip it from
         the merged manifest so the app declares no screen-capture capability
         (avoids the Play "screen sharing / foreground service" review flag). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove"/>
    <!-- Agora also merges in its screen-capture SERVICE + helper ACTIVITY and a bare
         FOREGROUND_SERVICE permission. This app never screen-shares, so a leftover
         mediaProjection foreground service would trip the Play screen-recording /
         foreground-service review. Strip the permission here and the two components
         inside <application> below. NFC is pulled in by a dependency and is unused.
         (READ_PHONE_STATE is intentionally NOT stripped — Agora uses it to pause
         audio for an incoming phone call; it is justifiable for a calling app and
         needs no Play permissions declaration.) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove"/>
    <uses-permission android:name="android.permission.NFC"
        tools:node="remove"/>
    <application
        android:label="Asktro Clarity"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Remove Agora's unused screen-sharing components so no mediaProjection
             (screen-recording) foreground service ships in the release bundle. We do
             not use Agora screen sharing; see the permission strips above. -->
        <service
            android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenSharingService"
            tools:node="remove" />
        <activity
            android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenCaptureAssistantActivity"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
